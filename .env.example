# 每个密码分别生成随机十六进制值；不提交真实 .env。
POSTGRES_ADMIN_PASSWORD=replace-with-random-admin-password
POSTGRES_API_PASSWORD=replace-with-random-api-password
POSTGRES_WORKER_PASSWORD=replace-with-random-worker-password
PUSH_READONLY_PASSWORD=replace-with-random-readonly-password
BOOTSTRAP_PASSWORD=replace-with-random-bootstrap-password
PUBLIC_ORIGIN=http://localhost:8088
COOKIE_SECURE=false
# 仅填写可信前置代理的精确地址/CIDR；默认不信任转发身份头。
TRUSTED_PROXY_CIDRS=
HTTP_PORT=8088
TENANT_DATASOURCES={}
NL2SQL_AGENT_API_KEY=
LLM_BASE_URL=https://localhost:9443/v1
LLM_MODEL=chat
LLM_INTENT_MAX_TOKENS=256
LLM_PLAN_MAX_TOKENS=512
# 网关与模型的 byte-BPE 映射和实际计价确认后才启用经营分析。
ANALYSIS_ENABLED=false
ANALYSIS_STRATEGY=adaptive
ANALYSIS_TOKENIZER=byte_bpe_upper_bound
# 包含推理 Token 的模型可调大，范围 256–4096；随任务冻结并同步预留预算。
ANALYSIS_MODEL_MAX_OUTPUT_TOKENS=1024
# 单次模型整体截止时间 5–60 秒；增大时仍受总活跃时间 180 秒约束。
ANALYSIS_MODEL_TIMEOUT_SECONDS=20
# 已知用量与下一步预留之和不得超过此值；接纳时冻结，范围 10000–100000。
ANALYSIS_MAX_TOKENS=30000
# 低 TPM 网关可配置 0–30 秒调用间隔，等待通过图 interrupt 持久保存。
ANALYSIS_MODEL_INTERVAL_SECONDS=0
ANALYSIS_CURRENCY=
ANALYSIS_PRICE_VERSION=
# 每百万 Token 的微货币单位价格；1000000 微单位=1货币单位。
ANALYSIS_INPUT_PRICE_MICROS=
ANALYSIS_OUTPUT_PRICE_MICROS=
ANALYSIS_MAX_COST_MICROS=
