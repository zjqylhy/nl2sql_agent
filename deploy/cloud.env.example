# 复制到 .env.cloud（Git 忽略），真实值通过云 Secret 服务管理。
API_IMAGE=registry.example.com/olist-api:replace-version
AGENT_IMAGE=registry.example.com/olist-agent:replace-version
WEB_IMAGE=registry.example.com/olist-web:replace-version
DATABASE_URL=postgres://platform_runtime:replace-password@postgres.example.com:5432/platform?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem
MIGRATION_DATABASE_URL=postgres://platform_migrator:replace-password@postgres.example.com:5432/platform?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem
PUBLIC_ORIGIN=https://analysis.example.com
SERVICE_KEY=replace-with-at-least-32-random-characters
# 所有 MySQL 映射配置 ssl_ca=/run/secrets/mysql-ca.pem。
TENANT_DATASOURCES={}
MYSQL_CA_FILE=/absolute/path/to/mysql-ca.pem
POSTGRES_CA_FILE=/absolute/path/to/postgres-ca.pem
# 与云主机已有网络避免冲突；修改网络时同步调整下面三个值。
COMPOSE_SUBNET=172.30.0.0/24
COMPOSE_GATEWAY=172.30.0.1
WEB_PRIVATE_IP=172.30.0.10
# 仅信任 web 与宿主转发的网关，禁止配置 0.0.0.0/0。
TRUSTED_PROXY_CIDRS=172.30.0.10/32,172.30.0.1/32
API_MEMORY_LIMIT=512m
AGENT_MEMORY_LIMIT=512m
WEB_MEMORY_LIMIT=128m
API_CPUS=1.0
AGENT_CPUS=1.0
WEB_CPUS=0.5
BIND_HOST=127.0.0.1
HTTP_PORT=8088
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
