FROM python:3.12-slim
ARG SOURCE_COMMIT=uncommitted
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY agent/requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock
COPY agent/runtime ./runtime
COPY agent/tools ./tools
RUN useradd --uid 10001 --create-home runtime
USER 10001
EXPOSE 8000
CMD ["uvicorn","runtime.app:app","--host","0.0.0.0","--port","8000","--no-access-log"]
