# 本地生成随机密码；线上通过 Secret 注入。此文件不能直接作为生产密钥。
POSTGRES_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-random-mysql-password
SERVICE_KEY=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:8088
COOKIE_SECURE=false
HTTP_PORT=8088
# 导入完成后填写；不同角色可指向不同受限视图/账号。
TENANT_DATASOURCES={}
# 从 Windows 用户环境变量加载到运行 Compose 的进程，不在 .env 放真实 Key。
NL2SQL_AGENT_API_KEY=
LLM_BASE_URL=https://localhost:9443/v1
LLM_MODEL=chat
LLM_INTENT_MAX_TOKENS=256
LLM_PLAN_MAX_TOKENS=512
# 分析默认关闭；只有确认网关模型为 byte-BPE 并配置实际价格后才启用。
ANALYSIS_ENABLED=false
# fixed 仅用于固定流程对照评测；工作台默认 adaptive。
ANALYSIS_STRATEGY=adaptive
ANALYSIS_TOKENIZER=byte_bpe_upper_bound
ANALYSIS_CURRENCY=
ANALYSIS_PRICE_VERSION=
# 每百万输入/输出 Token 的微货币单位价格；1000000 微单位等于 1 货币单位。
ANALYSIS_INPUT_PRICE_MICROS=
ANALYSIS_OUTPUT_PRICE_MICROS=
ANALYSIS_MAX_COST_MICROS=
