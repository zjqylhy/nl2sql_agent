# 使用 scripts/private_ops.py init-config 生成受限配置，不直接使用占位密码。
API_IMAGE=nl2sql-api:replace-commit
AGENT_IMAGE=nl2sql-agent:replace-commit
WEB_IMAGE=nl2sql-web:replace-commit
TUNNEL_IMAGE=nl2sql-tunnel:replace-commit
POSTGRES_IMAGE=postgres:17-alpine
MYSQL_IMAGE=mysql:8.4
POSTGRES_ADMIN_PASSWORD=replace-random-hex
POSTGRES_RUNTIME_PASSWORD=replace-random-hex
MYSQL_ROOT_PASSWORD=replace-random-hex
MYSQL_READONLY_PASSWORD=replace-random-hex
SERVICE_KEY=replace-random-hex
NL2SQL_AGENT_API_KEY=replace-gateway-application-key
TENANT_DATASOURCES={}
CSV_DIR=/srv/olist/csv
TUNNEL_KEY_FILE=/srv/olist/secrets/tunnel-key
GATEWAY_KNOWN_HOSTS_FILE=/srv/olist/secrets/gateway-known-hosts
GATEWAY_CA_FILE=/srv/olist/secrets/gateway-ca.pem
BOOTSTRAP_PASSWORD=replace-random-admin-password
